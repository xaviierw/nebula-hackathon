# Provided hackathon material - large / not ours to version
Backend/02_Datasets/
Backend/03_References/
Backend/04_Example_Submission/

# Virtual environment
.venv/

# Python artifacts
__pycache__/
*.pyc

# Editor and OS junk - contributors are on different machines
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Generated artefacts - keep the folder, ignore everything produced into it.
# Git cannot track an empty directory, so a .gitkeep placeholder is committed
# and re-included by the negation below.
#
#   output/  `python main.py predict`  -> door_predictions.csv, door_detail.csv
#
# model/ is now versioned deliberately: door_model.json, door_reference.json,
# door_model.joblib and training_report.json are the artefacts deployed at the
# final stage, so the trained model ships with the repo rather than being
# regenerated on every clone.
Backend/Door/output/*
!Backend/Door/output/.gitkeep

# Submission bundle - built from output/, never edited by hand
predictions.zip

# Frontend build artefacts, dependencies and local secrets
Frontend/node_modules/
Frontend/dist/
Frontend/.vite/
Frontend/.env*.local

# --- Backend API ---------------------------------------------------------
# The service account JSON itself must live outside the repo; these are
# belt-and-braces in case someone drops one in anyway.
Backend/.env
Backend/.env.*
!Backend/.env.example
*-firebase-adminsdk-*.json
serviceAccountKey.json

# Frontend/.env*.local is covered above, but a plain .env is not.
Frontend/.env

# Generated artefacts for the new subsystems, matching Door's rules above.
Backend/ACV/model/*
Backend/ACV/output/*
!Backend/ACV/model/.gitkeep
!Backend/ACV/output/.gitkeep
Backend/Rail_Corrugation/model/*
Backend/Rail_Corrugation/output/*
!Backend/Rail_Corrugation/model/.gitkeep
!Backend/Rail_Corrugation/output/.gitkeep
Backend/SHM/model/*
Backend/SHM/output/*
!Backend/SHM/model/.gitkeep
!Backend/SHM/output/.gitkeep

# Python bytecode from the API tier.
Backend/**/__pycache__/

# The Door INFERENCE artefacts are committable: door_model.json is ~400 bytes
# of plain numbers with no training data in it, and without it a fresh clone
# has a dead Door endpoint (Train.csv is gitignored, so model/ is NOT in fact
# reproducible from a clone).
!Backend/Door/model/door_model.json
!Backend/Door/model/door_reference.json

# Rail's fitted Extra Trees bundle is also required for a fresh deployment.
# It is validated against its feature contract and exact inference versions
# at startup; training data remains ignored.
!Backend/Rail_Corrugation/model/rail_corrugation.joblib
