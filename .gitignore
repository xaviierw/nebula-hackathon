Backend/02_Datasets/
Backend/03_References/
Backend/04_Example_Submission/

# Virtual environment
.venv/

# Python artifacts
__pycache__/
*.pyc

# Editor and OS junk - contributors are on different machines
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Generated artefacts - keep the folder, ignore everything produced into it.
# Git cannot track an empty directory, so a .gitkeep placeholder is committed
# and re-included by the negation below.
#
#   output/  `python main.py predict`  -> door_predictions.csv, door_detail.csv
#
# model/ is now versioned deliberately: door_model.json, door_reference.json,
# door_model.joblib and training_report.json are the artefacts deployed at the
# final stage, so the trained model ships with the repo rather than being
# regenerated on every clone.
Backend/Door/output/*
!Backend/Door/output/.gitkeep

# Submission bundle - built from output/, never edited by hand
predictions.zip
