# Copy to Backend/.env and fill in. Backend/.env is gitignored.
#
# Nothing in THIS file is a secret -- it is committed as a template. The one
# secret in the system is the service account JSON that
# FIREBASE_CREDENTIALS_FILE points at. Keep that file OUTSIDE this repo.

# --- Firebase ------------------------------------------------------------
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Save it somewhere like C:/Users/you/.secrets/ -- NOT in the repo.
FIREBASE_CREDENTIALS_FILE=C:/Users/you/.secrets/nebula-admin.json

# Same project id the frontend uses in VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=your-project-id

# --- Access --------------------------------------------------------------
# Comma-separated list of email domains allowed to sign in. LEAVE THIS EMPTY
# AT YOUR PERIL: Firebase Auth will happily authenticate any account in the
# world, and this is an internal tool. Empty means allow everyone.
ALLOWED_EMAIL_DOMAINS=

# --- Limits --------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- Behaviour -----------------------------------------------------------
# Set false to force every upload through the model, for benchmarking.
PREDICTION_CACHE_ENABLED=true
LOG_LEVEL=info

# --- Local development ---------------------------------------------------
# DEV_NO_AUTH=true removes authentication COMPLETELY. No Firebase key is
# needed, Firestore is not used (so no prediction cache and no run history),
# and every request is attributed to a fake user called "dev-local".
#
# It exists so the models can be exercised end to end before the Firebase
# project is set up, and so a teammate without a service-account key can
# still run the app. The server refuses to start with it on unless it is
# bound to loopback, and prints a warning banner on every boot.
#
# NEVER set this in a deployed environment.
DEV_NO_AUTH=false
